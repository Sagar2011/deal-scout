{
  "name": "deal-scout",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A traceable CLI for investment opportunity triage.",
  "bin": {
    "deal-scout": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "node --env-file=.env --import tsx src/index.ts",
    "test": "tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"./**/*.{js,ts,json}\"",
    "format:check": "prettier --check \"./**/*.{js,ts,json}\""
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "volta": {
    "node": "20.10.0",
    "npm": "10.2.3"
  },
  "devDependencies": {
    "@types/node": "20.17.30",
    "tsx": "4.19.3",
    "typescript": "5.8.3",
    "prettier": "2.8.0"
  },
  "dependencies": {
    "axios": "1.20.0"
  }
}
